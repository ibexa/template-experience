{
  "name": "@ibexa/ai-assistant-ui",
  "version": "0.19.1",
  "type": "module",
  "description": "Reusable React components for building AI assistant interfaces.",
  "license": "proprietary",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "dist/ibexa.ai-assistant.cjs.js",
  "module": "dist/ibexa.ai-assistant.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ibexa.ai-assistant.es.js",
      "require": "./dist/ibexa.ai-assistant.cjs.js"
    },
    "./styles.css": "./dist/ibexa.ai-assistant.css"
  },
  "files": [
    "dist"
  ],
  "prettier": "@ibexa/eslint-config/prettier",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prettier:check": "prettier \"./lib/**/*.{js,ts,jsx,tsx,css}\" --check",
    "prettier:fix": "npm run prettier:check -- --write",
    "eslint:check": "eslint \"./lib/**/*.{js,ts,jsx,tsx}\"",
    "eslint:fix": "npm run eslint:check -- --fix",
    "ts:check": "tsc --noEmit --project tsconfig.app.json",
    "cs:check": "npm run prettier:check && npm run eslint:check && npm run ts:check",
    "cs:fix": "npm run prettier:fix && npm run eslint:fix",
    "test:storybook:watch": "vitest --project=storybook",
    "test:storybook:run": "vitest run --project=storybook",
    "test:unit:watch": "vitest --project=unit",
    "test:unit:run": "vitest run --project=unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:unit:run && npm run test:storybook:run && npm run test:e2e",
    "prepare": "husky"
  },
  "peerDependencies": {
    "marked": "^17.0.1",
    "react": "^18.0.0 || ^19.1.0",
    "react-dom": "^18.0.0 || ^19.1.0",
    "react-intersection-observer": "^10.0.0",
    "react-intl": "^7.1.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.39.1",
    "@ibexa/eslint-config": "git+https://github.com/ibexa/eslint-config-ibexa.git#v2.0.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/node": "^24.10.0",
    "@types/react": "19",
    "@types/react-dom": "^19.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.11",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "prop-types": "^15.8.1",
    "storybook": "^10.1.11",
    "storybook-addon-pseudo-states": "^10.2.10",
    "storybook-react-context": "^0.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/work-sans": "^5.2.8",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-character-count": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-mention": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/suggestion": "^3.26.0",
    "dompurify": "^3.4.12",
    "fetch-event-stream": "^0.1.6",
    "react-error-boundary": "^6.1.0",
    "react-hotkeys-hook": "^5.2.3",
    "tiptap-markdown": "^0.9.0",
    "xliff": "^6.3.0"
  }
}
